{
  "AUTH_SERVICE_URL": "http://localhost:8081",
  "PESAJE_SERVICE_URL": "http://localhost:8082",
  "MAESTROS_SERVICE_URL": "http://localhost:8083",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        }
      },
      "controlpeso-route": {
        "ClusterId": "pesaje-cluster",
        "Match": {
          "Path": "/api/controlpeso/{**remainder}"
        }
      },
      "guias-route": {
        "ClusterId": "pesaje-cluster",
        "Match": {
          "Path": "/api/guias/{**remainder}"
        }
      },
      "pedidos-route": {
        "ClusterId": "pesaje-cluster",
        "Match": {
          "Path": "/api/pedidos/{**remainder}"
        }
      },
      "maestros-route": {
        "ClusterId": "maestros-cluster",
        "Match": {
          "Path": "/api/maestros/{**remainder}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://localhost:8081/"
          }
        }
      },
      "pesaje-cluster": {
        "Destinations": {
          "pesaje-destination": {
            "Address": "http://localhost:8082/"
          }
        }
      },
      "maestros-cluster": {
        "Destinations": {
          "maestros-destination": {
            "Address": "http://localhost:8083/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
